# Local working documents -- not checked in
/plan.md

# Rust build artifacts
# Unanchored, so it catches a target directory at any depth. It was anchored to
# the root, and a crate deliberately kept outside the workspace has a target
# directory of its own -- two thousand files of one got committed before this
# was noticed.
target/
# Any cross-build tree too: a board binary is built with
# CARGO_TARGET_DIR set aside so it does not evict the host's cache, and
# one of those got committed once because this line only named `target`.
/target-*
**/*.rs.bk

# Test output: diff images, JSON/JUnit reports, capture artifacts
/tests/output/
/tests/**/actual/
/tests/**/diff/

# Device-run artifacts pulled back from boards
/ci/results/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
